VITE_API_URL=/api

# Modo demonstração (ver src/scripts/mock.ts): enquanto "true" (ou ausente), o
# site inteiro roda com dados de mentira, sem precisar de backend nem banco de
# dados. Troque para "false" quando o banco de dados estiver pronto e você
# quiser testar com a API real.
VITE_MOCK_MODE=true
