VITE_API_URL=/api

# Modo demonstração (ver src/scripts/mock.ts): só liga se for "true". Com "false"
# (ou ausente) o site fala com a API real e SÓ aceita e-mails cadastrados.
VITE_MOCK_MODE=false

# Qual backend o `npm run dev` usa (opcional). Padrão: http://localhost:3000.
# Para usar o backend publicado (e o banco real) no seu computador, descomente:
# API_PROXY_TARGET=https://startmatch-api.onrender.com
